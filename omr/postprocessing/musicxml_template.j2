<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN"
        "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1">
      <part-name>Music</part-name>
    </score-part>
  </part-list>
  <part id="P1">
  {# 
    Duration conversion based on <divisions>
    With <divisions>4</divisions> (4 divisions per quarter note):
    - whole: 16
    - half: 8
    - quarter: 4
    - eighth: 2
    - 16th: 1
  #}
  {% set duration_map = {
    'whole': 16,
    'half': 8,
    'quarter': 4,
    'eighth': 2,
    '16th': 1
  } %}
  {% for measure in score.measures %}
    <measure number="{{ loop.index }}">

      {% set clef = score.clef_changes.get(loop.index, None) %}
      {% if loop.first or clef %}
      <attributes>
        {% if loop.first %}
        <divisions>4</divisions>
        <key><fifths>0</fifths></key>
        <time>
          <beats>{{ score.time_signature.beats }}</beats>
          <beat-type>{{ score.time_signature.beat_type }}</beat-type>
        </time>
        {% endif %}
        {% if clef %}
        <clef>
          <sign>{{ clef.value }}</sign>
          <line>2</line>
        </clef>
        {% elif loop.first %}
        <clef>
          <sign>{{ score.clef_changes.get(1).value if score.clef_changes.get(1) else 'G' }}</sign>
          <line>2</line>
        </clef>
        {% endif %}
      </attributes>
      {% endif %}

      {% for item in measure.items %}
      <note>
        {% if item.pitch is defined %}
        <pitch>
          <step>{{ item.pitch.step }}</step>
          {% if item.pitch.accidental == 'sharp' %}<alter>1</alter>
          {% elif item.pitch.accidental == 'flat' %}<alter>-1</alter>
          {% elif item.pitch.accidental == 'natural' %}<alter>0</alter>
          {% endif %}
          <octave>{{ item.pitch.octave }}</octave>
        </pitch>
        {% else %}
        <rest/>
        {% endif %}
        <duration>{{ duration_map.get(item.duration.value, 4) }}</duration>
        <type>{{ item.duration.value }}</type>
        {% if item.pitch is defined and item.pitch.accidental %}
        <accidental>{{ item.pitch.accidental }}</accidental>
        {% endif %}
        {% for _ in range(item.dots) %}
        <dot/>
        {% endfor %}
      </note>
      {% endfor %}
    </measure>
  {% endfor %}
  </part>
</score-partwise>
